{
  "name": "@klosers/functions",
  "version": "0.0.0",
  "private": true,
  "description": "Klosers CRM Cloud Functions for Firebase (2nd gen, TypeScript)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --outfile=lib/index.js"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2"
  }
}
