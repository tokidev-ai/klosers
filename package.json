{
  "name": "klosers",
  "version": "0.0.0",
  "private": true,
  "description": "Klosers CRM: Angular app, Cloud Functions and Firestore rules in one repository",
  "workspaces": [
    "apps/*",
    "functions"
  ],
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "start": "npm run start --workspace apps/web",
    "emulators": "firebase emulators:start",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p shared",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "fix": "eslint . --fix && prettier --write .",
    "deploy": "firebase deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.37.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0"
  }
}
