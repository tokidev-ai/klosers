rules_version = '2';

// Baseline: deny every read and write from apps.
// The Admin SDK (Cloud Functions, seed script) is not affected by these rules.
// P1-01 replaces this file with the real rules and their tests.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
